# Warehouse Neon: paste the connection string from Neon Connect.
# Keep sslmode=require (or verify-full) and channel_binding from Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/nusantaratv_dw?sslmode=require&channel_binding=require
# Optional direct URL: disable Connection pooling in Neon and copy that URL.
# If set, it takes priority over DATABASE_URL. Both must use the same database.
DATABASE_URL_UNPOOLED=

# Internal Airflow metadata database only (not the news warehouse).
AIRFLOW_DB_PASSWORD=choose_your_metadata_database_password
# Login dashboard: username admin
AIRFLOW_ADMIN_PASSWORD=choose_your_dashboard_password
AIRFLOW_UI_PORT=18080
