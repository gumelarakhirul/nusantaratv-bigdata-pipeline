# Warehouse Neon: tempel URL koneksi dari menu Connect Neon.
# Pertahankan sslmode=require (atau verify-full) dan channel_binding dari Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/nusantaratv_dw?sslmode=require&channel_binding=require
# Untuk ETL/DDL, gunakan URL langsung dengan mematikan Connection pooling.

# Password database metadata internal Airflow.
AIRFLOW_DB_PASSWORD=choose_your_metadata_database_password
# Password masuk dashboard dengan nama pengguna admin.
AIRFLOW_ADMIN_PASSWORD=choose_your_dashboard_password
AIRFLOW_UI_PORT=18080
